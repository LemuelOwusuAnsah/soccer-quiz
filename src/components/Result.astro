<section id="result" class="result-screen" style="display:none;">
  <h2 class="result-title">Quiz complete</h2>
  <p id="resultMessage" class="result-message"></p>
  <div class="result-score">
    <span id="resultScore">0</span>
    <span class="result-total">/ <span id="resultTotal">10</span></span>
  </div>
  <p id="resultPercent" class="result-percent"></p>

  <form id="saveForm" class="save-form" autocomplete="off">
    <label for="playerName" class="field-label">Name (optional)</label>
    <div class="save-row">
      <input type="text" id="playerName" maxlength="20" placeholder="Anonymous" />
      <button type="submit" class="btn btn-primary save-btn">Save score</button>
    </div>
  </form>

  <button id="playAgainBtn" class="btn btn-primary play-again" type="button">Play again</button>

  <div class="leaderboard-section">
    <h3>Leaderboard</h3>
    <ol id="leaderboardList" class="leaderboard-list"></ol>
    <p id="leaderboardEmpty" class="leaderboard-empty" style="display:none;">No scores yet.</p>
  </div>
</section>

<style>
  .result-screen { display: flex; flex-direction: column; gap: 1rem; }
  .result-title { font-size: 1.15rem; font-weight: 600; margin: 0; text-align: center; }
  .result-message { font-size: 0.95rem; color: var(--fg-muted); text-align: center; margin: 0; }
  .result-score { text-align: center; font-family: var(--mono); font-weight: 700; color: var(--fg); }
  .result-score #resultScore { font-size: 3rem; line-height: 1; }
  .result-total { font-size: 1.25rem; color: var(--fg-muted); font-weight: 500; }
  .result-percent { text-align: center; font-size: 0.85rem; color: var(--fg-muted); margin: 0; }
  .save-form { margin: 0.5rem 0; }
  .field-label { display: block; font-size: 0.85rem; font-weight: 500; color: var(--fg-muted); margin-bottom: 0.4rem; }
  .save-row { display: flex; gap: 0.5rem; }
  .save-row input { flex: 1; padding: 0.65rem 0.9rem; border: 1px solid var(--border); border-radius: var(--radius); background: var(--bg); color: var(--fg); font: inherit; font-size: 0.9rem; outline: none; }
  .save-row input:focus { border-color: var(--border-strong); }
  .btn { display: inline-flex; align-items: center; justify-content: center; padding: 0.75rem 1rem; border-radius: var(--radius-pill); border: 1px solid transparent; font: inherit; font-weight: 500; font-size: 0.9rem; cursor: pointer; }
  .btn-primary { background: var(--fg); color: var(--bg); }
  .btn-primary:hover { opacity: 0.9; }
  .save-btn { padding: 0.65rem 1.1rem; font-size: 0.85rem; }
  .play-again { width: 100%; margin-top: 0.5rem; }
  .leaderboard-section { margin-top: 1rem; padding-top: 1rem; border-top: 1px solid var(--border); }
  .leaderboard-section h3 { font-size: 0.9rem; font-weight: 600; margin: 0 0 0.75rem; }
  .leaderboard-list { list-style: decimal; padding-left: 1.5rem; margin: 0; display: grid; gap: 0.25rem; }
  .leaderboard-list li { font-size: 0.85rem; color: var(--fg); display: flex; justify-content: space-between; gap: 0.5rem; }
  .leaderboard-list .lb-name { color: var(--fg-muted); }
  .leaderboard-list .lb-score { font-family: var(--mono); font-weight: 600; }
  .leaderboard-empty { font-size: 0.82rem; color: var(--fg-dim); font-style: italic; text-align: center; margin: 0; }
</style>
